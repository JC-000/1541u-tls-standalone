# The engine under test: the 1541 Ultimate firmware commit whose software/wifi/raw_u64/main/tls_engine.[ch] this app
# compiles. To test another commit, set ENGINE_SHA, fetch it, and build: tools/verify_transcriptions.py then says
# whether the app's copies of the bridge handlers and the Ultimate's checks still match that commit.
# tools/fetch_engine.sh fetches from ENGINE_URL; ENGINE_URL_ENV in the environment overrides it (a clone or mirror).
ENGINE_URL="[SOURCE BRANCH LINK]"
